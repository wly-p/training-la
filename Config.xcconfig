// 專案層級共用設定：套用到全部 build configuration（連 App 本身的 build 都會讀到，
// 不是只有測試才用），Makefile 與 Xcode 專案共用同一份（單一真實來源）。
// 改這裡就好，不要在 Makefile / project.yml 裡另外寫死。
//
// TEST_DEVICE：跑 UITests 用的模擬器機型名稱（對應 `xcrun simctl list devicetypes`）。
// Makefile 用它組 `xcodebuild -destination`；同時也放進 Xcode 的 Build Settings（User-Defined），
// 讓專案裡讀得到同一個值——但 Xcode GUI 工具列的模擬器下拉選單是互動式狀態，
// 不會被這個值動態帶動，仍要在 Xcode 裡手動選（這是 Xcode 本身的限制）。
TEST_DEVICE = iPhone 17

// TEST_HEADLESS（bool：true/false）：true（預設）＝ 不主動打開 Simulator.app 視覺化視窗；
// false ＝ Makefile 會先 `open -a Simulator` 讓你能看著 UITests 跑。
// 不管哪個值，xcodebuild 都還是會啟動模擬器 process，這個開關只影響「要不要順便開視窗給人看」。
TEST_HEADLESS = true

// TEST_LANGUAGE：跑 UITests 時要用哪個 test plan configuration（＝模擬器的裝置語系）。
// UITests.xctestplan 只留 zh-Hant 一個——把裝置語系釘死，測試才不依賴跑測試的那台機器
// （E2E 第一次上 CI 就是栽在英文模擬器）。
//
// 這裡換的是**裝置語系**，不是 app 語言。要驗「app 語言 ≠ 裝置語系」的中英混雜問題，
// 跑 `make test-uitest-en`——它把同一批測試再跑一輪，只把 app 語言換成英文。
TEST_LANGUAGE = zh-Hant

// TEST_REPORT（bool：true/false）：false（預設）＝ 跟沒有這個功能之前完全一樣，不產生任何檔案；
// true ＝ 測試完把結果解析後上傳 Notion 的 Test Result 資料庫，產物落在 gitignored 的 test-reports/。
// 上傳失敗只印警告，不會改變 make 的結束碼——exit code 要反映測試結果本身。
TEST_REPORT = false

// PRIVACY_POLICY_URL：隱私政策頁的網址。build 時展開進 Info.plist 的 `PrivacyPolicyURL`
// （見 project.yml），App 只從那裡讀 —— Swift 裡永遠不出現網址字串（同 AppEnvironment.swift 的規矩）。
// 政策頁還沒部署，目前指向本機 mock server：
//   cd ../mock-url && python3 -m http.server 8000
// 上線後只改這一行（換成正式網址），Swift 與 View 都不用動。
//
// 雙斜線用 SLASH 繞開：xcconfig 把 `//` 當註解起點，直接寫 http://... 的值會被截成 `http:`。
SLASH = /
PRIVACY_POLICY_URL = http:$(SLASH)$(SLASH)localhost:8000$(SLASH)privacy-policy.html

// 本機簽章設定（gitignored，開源 repo 不放任何人的 Team ID）。
// 實機建置前自己建一份 Signing.secrets.xcconfig，內容一行：
//   DEVELOPMENT_TEAM = <你的 Team ID>
// 沒有這個檔也能過（optional include），只是要在 Xcode GUI 手選 team，
// 且每次 `xcodegen generate` 後得重選；有這個檔就能在重生後存活。
#include? "Signing.secrets.xcconfig"
