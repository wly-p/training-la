{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "ability.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "ability.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }
      }
    },
    "ability.editNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled weights are locked in — changing this won't affect them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排定的課表重量已鎖定，改這裡不會動到。"
          }
        }
      }
    },
    "ability.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercises you have trained will show up here. Go finish a workout first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練過的動作才會出現在這裡。先去訓練分頁練一場吧。"
          }
        }
      }
    },
    "ability.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No exercises yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可設定的動作"
          }
        }
      }
    },
    "ability.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating an ability value never changes schedules already generated — those weights were resolved and locked in at that moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改能力值不會動到已排定的課表——那些重量在排課那一刻就已經算好、寫死了。"
          }
        }
      }
    },
    "ability.kicker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max weight"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大重量"
          }
        }
      }
    },
    "ability.notSet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定"
          }
        }
      }
    },
    "ability.source.estimated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from history"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依紀錄推算"
          }
        }
      }
    },
    "ability.source.manual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually entered"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動填入"
          }
        }
      }
    },
    "ability.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議"
          }
        }
      }
    },
    "ability.suggestionBanner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your latest record, consider updating to"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依最近一次紀錄，建議更新到"
          }
        }
      }
    },
    "ability.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Ability Values"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的能力值"
          }
        }
      }
    }
  },
  "version": "1.0"
}
