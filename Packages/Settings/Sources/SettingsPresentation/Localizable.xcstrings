    "settings.eraseAll.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase All Data"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所有資料"
          }
        }
      }
    },
    "settings.eraseAll.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All exercises, plans, workout records, and ability values will be permanently deleted. This cannot be undone, and there is currently no way to export a backup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有動作、課表、訓練紀錄與能力值將被永久刪除。無法復原，且目前沒有匯出備份的功能。"
          }
        }
      }
    },
    "settings.eraseAll.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定刪除所有資料？"
          }
        }
      }
    },
    "settings.eraseFailed.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while erasing data. Please try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除資料時發生錯誤，請再試一次。"
          }
        }
      }
    },
    "settings.eraseFailed.title": {
      "localizations": {
