{
  "meta": {
    "version": 1,
    "note": "元件庫 token 的唯一來源。改任何值只改這裡，然後跑 scripts/gen-tokens.py。",
    "generates": [
      "Packages/DesignSystem/Sources/DesignSystem/DesignTokens.swift",
      "design-system/tokens/tokens.css",
      "design-system/tokens/tokens.preview.html"
    ],
    "dimensions": {
      "theme": "語意色有 light / dark 兩組。dark 目前是 light 的複製——位置先留好，實際色階等 C6a。",
      "language": "字級有語言補償：英文 = 中文 × 1.08（四捨五入到整數）。中文撐滿字身框、英文只有 x-height。",
      "dynamicType": "每個字級角色留 relativeTo 欄位，目前一律 null。支援範圍等 C7a。"
    }
  },
  "primitive": {
    "_comment": "scaleBase：該色階的 500 是否另有一個裸名（TLColor.accent）。neutral 沒有，一律 neutralNNN。",
    "scaleBase": {
      "accent": "500",
      "sage": "500",
      "danger": "500",
      "neutral": null
    },
    "color": {
      "sand": {
        "base": "#F5EAD8",
        "raised": "#EBDDC5"
      },
      "ink": {
        "900": "#201E1D"
      },
      "accent": {
        "100": "#FFF2EB",
        "200": "#FFE1D0",
        "300": "#FFC6A5",
        "400": "#F6A06B",
        "500": "#C67139",
        "600": "#B2622D",
        "700": "#8C491A",
        "800": "#643312",
        "900": "#402310"
      },
      "sage": {
        "100": "#F0FAE1",
        "200": "#E1EECC",
        "300": "#CCDBB2",
        "400": "#AEBF92",
        "500": "#7A8A5E",
        "600": "#728157",
        "700": "#56633F",
        "800": "#3D472B",
        "900": "#272E1B"
      },
      "neutral": {
        "100": "#F9F4ED",
        "200": "#EEE7DB",
        "300": "#DCD3C4",
        "400": "#C0B6A5",
        "500": "#A19786",
        "600": "#82796A",
        "700": "#645C50",
        "800": "#474238",
        "900": "#2E2B25"
      },
      "danger": {
        "100": "#FAEDE8",
        "200": "#F3DDD6",
        "300": "#D9A89B",
        "400": "#B8776A",
        "500": "#D96552",
        "600": "#B74736",
        "700": "#7E3123",
        "800": "#661F14",
        "900": "#40140D"
      }
    }
  },
  "semantic": {
    "color": {
      "surfaceBase": {
        "role": "頁面底色",
        "light": {
          "ref": "sand.base"
        },
        "dark": {
          "ref": "sand.base"
        }
      },
      "surfaceRaised": {
        "role": "卡片／群組容器底",
        "light": {
          "ref": "neutral.100"
        },
        "dark": {
          "ref": "neutral.100"
        }
      },
      "surfaceTrack": {
        "role": "分段控制軌道",
        "light": {
          "ref": "neutral.200"
        },
        "dark": {
          "ref": "neutral.200"
        }
      },
      "surfaceInput": {
        "role": "輸入色帶（訓練頁）",
        "light": {
          "ref": "neutral.300"
        },
        "dark": {
          "ref": "neutral.300"
        }
      },
      "textPrimary": {
        "role": "主文字",
        "light": {
          "ref": "ink.900"
        },
        "dark": {
          "ref": "ink.900"
        }
      },
      "textSecondary": {
        "role": "二級文字",
        "light": {
          "ref": "neutral.600"
        },
        "dark": {
          "ref": "neutral.600"
        }
      },
      "textTertiary": {
        "role": "三級文字／icon",
        "light": {
          "ref": "neutral.500"
        },
        "dark": {
          "ref": "neutral.500"
        }
      },
      "textNumeric": {
        "role": "大數字",
        "light": {
          "ref": "neutral.900"
        },
        "dark": {
          "ref": "neutral.900"
        }
      },
      "borderSubtle": {
        "role": "列間分隔線",
        "light": {
          "ref": "ink.900",
          "alpha": 0.08
        },
        "dark": {
          "ref": "ink.900",
          "alpha": 0.08
        }
      },
      "actionPrimary": {
        "role": "可操作的東西（赭紅）",
        "light": {
          "ref": "accent.500"
        },
        "dark": {
          "ref": "accent.500"
        }
      },
      "actionPressed": {
        "role": "實心按鈕按下態",
        "light": {
          "ref": "accent.600"
        },
        "dark": {
          "ref": "accent.600"
        }
      },
      "categoryTag": {
        "role": "分類標示（肌群）",
        "light": {
          "ref": "sage.500"
        },
        "dark": {
          "ref": "sage.500"
        }
      },
      "dangerSolid": {
        "role": "破壞性實心底",
        "light": {
          "ref": "danger.600"
        },
        "dark": {
          "ref": "danger.600"
        }
      },
      "accentOnSurface": {
        "role": "在容器底上的可讀 accent 文字",
        "light": {
          "ref": "accent.700"
        },
        "dark": {
          "ref": "accent.700"
        }
      },
      "dangerOnSurface": {
        "role": "在容器底上的破壞性文字／外框",
        "light": {
          "ref": "danger.700"
        },
        "dark": {
          "ref": "danger.700"
        }
      }
    }
  },
  "space": {
    "page": 26,
    "section": 26,
    "rowInset": 18,
    "gapS": 8,
    "gapM": 13,
    "gapL": 20
  },
  "radius": {
    "container": 28,
    "inner": 20,
    "pill": 999
  },
  "size": {
    "row": 56,
    "rowWithSub": 62,
    "rowWithDetail": 68,
    "rowHistory": 66,
    "badge": 36,
    "iconButton": 44,
    "iconButtonSmall": 34,
    "minTap": 44,
    "switchW": 46,
    "switchH": 28
  },
  "type": {
    "families": {
      "display": {
        "name": "Caprasimo",
        "source": "bundled",
        "file": "Caprasimo-Regular.ttf",
        "use": "數字與英文"
      },
      "zh": {
        "name": "PingFang TC",
        "source": "system",
        "designProxy": "Noto Sans TC",
        "use": "中文",
        "previewFont": "NotoSansTC-subset.woff2",
        "_note": "實作用系統的 PingFang TC；preview 用包內的 Noto Sans TC 子集，與設計稿一致。子集由 scripts/gen-preview-font.py 從 preview 實際用到的字產生。"
      },
      "en": {
        "name": "system",
        "source": "system",
        "use": "英文介面文字"
      }
    },
    "languageScale": {
      "en": 1.08,
      "rounding": "整數四捨五入",
      "_note": "四捨五入只作用在『中文值 × 1.08』的結果，基準值本身可以是小數（rowSub 11.5 × 1.08 = 12.42 → 12）。"
    },
    "roles": {
      "pageTitle": {
        "size": 34,
        "relativeTo": null,
        "note": "頁面主標，允許兩行",
        "family": "zh"
      },
      "cardTitle": {
        "size": 21,
        "relativeTo": null,
        "family": "zh"
      },
      "rowTitle": {
        "size": 15,
        "relativeTo": null,
        "family": "zh"
      },
      "rowSub": {
        "size": 11.5,
        "relativeTo": null,
        "family": "zh"
      },
      "kicker": {
        "size": 10.5,
        "relativeTo": null,
        "tracking": 0.16,
        "trackingUnit": "em",
        "note": "大寫",
        "family": "zh"
      },
      "bigNumber": {
        "size": 66,
        "relativeTo": null,
        "note": "訓練頁重量／次數",
        "family": "display"
      }
    }
  },
  "shadow": {
    "sm": {
      "color": {
        "ref": "neutral.900",
        "alpha": 0.14
      },
      "radius": 2,
      "y": 1,
      "use": "卡片"
    },
    "md": {
      "color": {
        "ref": "neutral.900",
        "alpha": 0.16
      },
      "radius": 10,
      "y": 3,
      "use": "分段控制選中膠囊"
    },
    "lg": {
      "color": {
        "ref": "neutral.900",
        "alpha": 0.22
      },
      "radius": 32,
      "y": 12,
      "use": "對話框"
    }
  },
  "icon": {
    "s": 13,
    "m": 16,
    "l": 20,
    "weight": "semibold",
    "_note": "SF Symbol 的視覺尺寸。設計端對應 Lucide，stroke width 2.75。"
  },
  "motion": {
    "fast": 0.15,
    "base": 0.2,
    "curve": "easeOut",
    "_note": "來自程式碼現況：easeOut 0.2（4 處）、0.18（1 處）、0.15（1 處）。0.18 是落單值，之後應收斂到 fast 或 base，收斂前不要新增第四個值。"
  }
}
