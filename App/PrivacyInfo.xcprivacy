<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 不追蹤：沒有任何第三方 SDK、沒有廣告識別碼、沒有跨 app／網站的資料串接。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- 不蒐集：資料全部存在裝置上（SwiftData），App 沒有自家後端，也不會把任何東西送出去。
	     匯出檔是使用者自己按分享才產生的，不算「蒐集」。
	     之後接 CloudKit／任何分析工具時，這一段與 App Store Connect 的資料揭露表要一起改。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- required reason API：只有 UserDefaults（主題、語言、重量單位、級距、休息提醒偏好）。
	     CA92.1＝只讀寫 app 自己寫進去的值。缺這一段上傳會收到 ITMS-91053。
	     新增用到檔案時間戳、開機時間、磁碟空間、鍵盤清單的程式碼時要回來補對應類別。 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
